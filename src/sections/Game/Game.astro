---
import Square from "./Square.astro";
---

<script>
  import {
    GAME_STATE,
    SPACE_STATE,
    calculateAITurn,
    checkWinner,
    gameState,
    grid,
    handlePlayerClick,
    moveCount,
    winSpaces,
    fillGridSpace,
    reset,
  } from "./Ai";
  import confetti from "canvas-confetti";

  const squares = document.querySelectorAll(".square-item");
  squares.forEach((square) => {
    const sqIndex = square.getAttribute("data-sqindex");
    if (!sqIndex) return;
    square.addEventListener("click", () => handleClick(sqIndex));
  });

  const resetBtn = document.getElementById("reset-button");
  resetBtn?.addEventListener("click", reset);

  const handleClick = (sqIndex: string) => {
    handlePlayerClick(Number(sqIndex));
  };

  const celebrate = () => {
    const end = Date.now() + 1 * 1000;
    const colors = ["#bb0000", "#ffffff", "#2AB7CA", "#EEB902"];

    (function frame() {
      confetti({
        particleCount: 4,
        angle: 360,
        spread: 110,
        origin: { y: 0, x: -0.2 },
        colors: colors,
      });

      confetti({
        particleCount: 4,
        angle: 180,
        spread: 110,
        origin: { y: 0, x: 1.2 },
        colors: colors,
      });

      confetti({
        particleCount: 4,
        angle: -90,
        spread: 55,
        origin: { y: -0.8 },
        colors: colors,
      });

      if (Date.now() < end) {
        requestAnimationFrame(frame);
      }
    })();
  };

  const finish = (result: { winner: string; winSpaces: number[] }) => {
    gameState.set(result.winner);
    winSpaces.set(result.winSpaces);

    const winClass =
      result.winner === GAME_STATE.PLAYER_WON ? "x-winner" : "o-winner";
    result.winSpaces.forEach((i) =>
      document.getElementById(`square-${i}`)?.classList.add(winClass)
    );

    if (result.winner === GAME_STATE.PLAYER_WON) {
      window.posthog.capture(`$$Player_Won`);
      celebrate();
    } else if (result.winner === GAME_STATE.AI_WON) {
      window.posthog.capture(`$$AI_Won`);
    }
  };

  // Runs after every player move (state flips to AI_TURN).
  gameState.subscribe((state) => {
    if (state !== GAME_STATE.AI_TURN) return;

    const playerResult = checkWinner(grid.get(), moveCount.get());
    if (playerResult) return finish(playerResult);

    setTimeout(() => {
      // Reset may have happened during the delay.
      if (gameState.get() !== GAME_STATE.AI_TURN) return;

      fillGridSpace(
        calculateAITurn(grid.get(), moveCount.get()),
        SPACE_STATE.AI
      );
      moveCount.set(moveCount.get() + 1);

      const aiResult = checkWinner(grid.get(), moveCount.get());
      if (aiResult) finish(aiResult);
      else gameState.set(GAME_STATE.PLAYER_TURN);
    }, 100);
  });
</script>

<section class="game-board pt-6 pb-10">
  <div class="max-w-md mx-auto">
    <div class="max-w-lg flex flex-col gap-5 mx-auto">
      <div class="flex gap-5 mx-auto">
        <Square squareIndex={0} />
        <Square squareIndex={1} />
        <Square squareIndex={2} />
      </div>
      <div class="flex gap-5 mx-auto">
        <Square squareIndex={3} />
        <Square squareIndex={4} />
        <Square squareIndex={5} />
      </div>
      <div class="flex gap-5 mx-auto">
        <Square squareIndex={6} />
        <Square squareIndex={7} />
        <Square squareIndex={8} />
      </div>
    </div>

    <div class="text-center">
      <button
        id="reset-button"
        class="bg-neutral-800 border text-neutral-200 tracking-wide border-neutral-700 px-4 py-1 text-[13px] font-medium mt-10 rounded-sm shadow-lg"
      >
        Reset
      </button>
    </div>
  </div>
</section>
